{
  "require": {
    "php": "^8.4",
    "symfony/http-foundation": "^7.0",
    "nikic/fast-route": "^1.3",
    "twig/twig": "^3.11",
    "php-di/php-di": "^7.0",
    "doctrine/dbal": "^4.0",
    "ramsey/uuid": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/",
      "Migrations\\": "migrations/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require-dev": {
    "tracy/tracy": "^3.0",
    "phpunit/phpunit": "^11.0"
  }
}
